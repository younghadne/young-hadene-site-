# Groq AI API (get key at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: custom endpoint (default is Groq)
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=mixtral-8x7b-32768
# GROQ_MAX_TOKENS=800

# --- Email marketing (SES + unsubscribe), all server-side only ---
# AWS IAM user with ONLY ses:SendEmail + ses:GetAccount on the sending identity:
# AWS_ACCESS_KEY_ID=AKIA... (set in Cloudflare Pages env secrets, never here)
# AWS_SECRET_ACCESS_KEY=... (Cloudflare Pages env secret only)
# AWS_REGION=us-east-1 (or your SES region)
# EMAIL_SECRET=long-random-string-for-unsubscribe-tokens (Cloudflare secret)
# EMAIL_WEBHOOK_KEY=long-random-string-for-SNS-endpoint (Cloudflare secret)
